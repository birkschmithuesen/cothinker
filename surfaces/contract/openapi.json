  "info": {
    "description": "The machine-readable contract between a surface and the core (ADR 0019): stage-state snapshot, the view-intent push channel and user actions.",
    "title": "CoThinker surface contract",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/actions": {
      "post": {
        "description": "A user action sent back by a surface (ADR 0006); accepted, not acted on.",
        "operationId": "post_action_actions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "discriminator": {
                  "mapping": {
                    "accept": "#/components/schemas/AcceptAction",
                    "choose": "#/components/schemas/ChooseAction",
                    "edit": "#/components/schemas/EditAction",
                    "reject": "#/components/schemas/RejectAction",
                    "tap": "#/components/schemas/TapAction",
                    "voice": "#/components/schemas/VoiceAction"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ChooseAction"
                  },
                  {
                    "$ref": "#/components/schemas/AcceptAction"
                  },
                  {
                    "$ref": "#/components/schemas/RejectAction"
                  },
                  {
                    "$ref": "#/components/schemas/EditAction"
                  },
                  {
                    "$ref": "#/components/schemas/TapAction"
                  },
                  {
                    "$ref": "#/components/schemas/VoiceAction"
                  }
                ],
                "title": "Action"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Post Action Actions Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Action",
        "tags": [
          "actions"
        ]
      }
    },
    "/events": {
      "get": {
        "description": "Server-sent events: one `view-intent` event per pushed intent.",
        "operationId": "get_events_events_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Events",
        "tags": [
          "events"
        ]
      }
    },
    "/snapshot": {
