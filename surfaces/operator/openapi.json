{
  "components": {
    "schemas": {
      "Call": {
        "properties": {
          "last": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CallAttempt"
              },
              {
                "type": "null"
              }
            ],
            "description": "The most recent call attempt; `None` before the first one."
          }
        },
        "title": "Call",
        "type": "object"
      },
      "CallAttempt": {
        "properties": {
          "answered": {
            "description": "Whether the call was answered.",
            "examples": [
              true
            ],
            "title": "Answered",
            "type": "boolean"
          },
          "at": {
            "description": "Wall-clock label of this call attempt.",
            "examples": [
              "2026-11-24T09:01:00+01:00"
            ],
            "title": "At",
            "type": "string"
          },
          "latency_s": {
            "description": "Seconds between dialling and the call being answered.",
            "examples": [
              1.2
            ],
            "title": "Latency S",
            "type": "number"
          }
        },
        "required": [
          "at",
          "answered",
          "latency_s"
        ],
        "title": "CallAttempt",
        "type": "object"
      },
      "Disk": {
        "properties": {
          "free_percent": {
            "description": "Free disk space, as a percentage.",
            "examples": [
              71.5
            ],
            "title": "Free Percent",
            "type": "number"
          }
        },
        "required": [
          "free_percent"
        ],
        "title": "Disk",
        "type": "object"
      },
      "ErrorEntry": {
        "properties": {
          "at": {
            "description": "Wall-clock label of when the error happened.",
            "examples": [
              "2026-11-24T09:02:00+01:00"
            ],
            "title": "At",
            "type": "string"
          },
          "message": {
            "description": "A redacted error message: no tokens, no paths outside the project, no transcript text.",
            "examples": [
              "reconnect after timeout"
            ],
            "title": "Message",
            "type": "string"
          },
          "service": {
            "description": "Which service raised the error.",
            "examples": [
              "stt"
            ],
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "at",
          "service",
          "message"
        ],
        "title": "ErrorEntry",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Meeting": {
        "properties": {
          "count": {
            "description": "Number of participants currently in the meeting.",
            "examples": [
              1
            ],
            "title": "Count",
            "type": "integer"
          },
          "participants": {
            "description": "Everyone currently in the meeting.",
            "items": {
              "$ref": "#/components/schemas/Participant"
            },
            "title": "Participants",
            "type": "array"
          }
        },
        "required": [
          "count"
        ],
        "title": "Meeting",
        "type": "object"
      },
      "OperatorStatus": {
        "description": "The full snapshot `GET /operator/status` returns and `GET\n/operator/events` pushes (event `operator-status`) on change, at most\nonce a second.",
        "properties": {
          "call": {
            "$ref": "#/components/schemas/Call"
          },
          "can_switch_project": {
            "description": "Whether `POST /operator/project` would be accepted right now.",
            "examples": [
              false
            ],
            "title": "Can Switch Project",
            "type": "boolean"
          },
          "disk": {
            "$ref": "#/components/schemas/Disk"
          },
          "errors": {
            "description": "The last 10 errors, oldest first.",
            "items": {
              "$ref": "#/components/schemas/ErrorEntry"
            },
            "title": "Errors",
            "type": "array"
          },
          "meeting": {
            "$ref": "#/components/schemas/Meeting"
          },
          "running": {
            "description": "Whether a meeting is currently running.",
            "examples": [
              true
            ],
            "title": "Running",
            "type": "boolean"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/Service"
            },
            "title": "Services",
            "type": "array"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "stt": {
            "$ref": "#/components/schemas/Stt"
          }
        },
        "required": [
          "meeting",
          "stt",
          "session",
          "call",
          "disk",
          "running",
          "can_switch_project"
        ],
        "title": "OperatorStatus",
        "type": "object"
      },
      "Participant": {
        "properties": {
          "level_dbfs": {
            "description": "Current audio level in dBFS.",
            "examples": [
              -18.0
            ],
            "title": "Level Dbfs",
            "type": "number"
          },
          "name": {
            "description": "Display name of the participant.",
            "examples": [
              "Mira"
            ],
            "title": "Name",
            "type": "string"
          },
          "speaking": {
            "description": "Whether this participant currently holds the floor.",
            "examples": [
              true
            ],
            "title": "Speaking",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "speaking",
          "level_dbfs"
        ],
        "title": "Participant",
        "type": "object"
      },
      "Project": {
        "properties": {
          "id": {
            "description": "Identity of this working folder; never a free path.",
            "examples": [
              "quarterly-planning"
            ],
            "title": "Id",
            "type": "string"
          },
          "label": {
            "description": "Display label for this working folder.",
            "examples": [
              "Quarterly planning"
            ],
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "Project",
        "type": "object"
      },
      "ProjectRequest": {
        "properties": {
          "project_id": {
            "description": "Id of an allowed working folder.",
            "examples": [
              "quarterly-planning"
            ],
            "title": "Project Id",
            "type": "string"
          }
        },
        "required": [
          "project_id"
        ],
        "title": "ProjectRequest",
        "type": "object"
      },
      "Service": {
        "properties": {
          "name": {
            "description": "Which part of the stack this entry reports on.",
            "enum": [
              "meeting",
              "stt",
              "audio-tap",
              "minutes",
              "stage",
              "contract"
            ],
            "examples": [
              "stt"
            ],
            "title": "Name",
            "type": "string"
          },
          "since": {
            "description": "Wall-clock label of when this service entered `state`.",
            "examples": [
              "2026-11-24T09:00:00+01:00"
            ],
            "title": "Since",
            "type": "string"
          },
          "state": {
            "description": "The service's current lifecycle state.",
            "enum": [
              "active",
              "starting",
              "stopped",
              "failed"
            ],
            "examples": [
              "active"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "name",
          "state",
          "since"
        ],
        "title": "Service",
        "type": "object"
      },
      "Session": {
        "properties": {
          "agenda": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionAgenda"
              },
              {
                "type": "null"
              }
            ],
            "description": "`None` for a session without an agenda."
          },
          "last_saved_at": {
            "description": "Wall-clock label of the last save; empty when nothing was saved yet.",
            "examples": [
              "2026-11-24T09:05:00+01:00"
            ],
            "title": "Last Saved At",
            "type": "string"
          },
          "project": {
            "$ref": "#/components/schemas/Project"
          },
          "session_folder": {
            "description": "Name of the current session's folder; empty when none is running.",
            "examples": [
              "2026-11-24-quarterly-planning"
            ],
            "title": "Session Folder",
            "type": "string"
          },
          "utterances": {
            "description": "Number of transcript utterances recorded so far.",
            "examples": [
              12
            ],
            "title": "Utterances",
            "type": "integer"
          }
        },
        "required": [
          "project",
          "session_folder",
          "utterances",
          "last_saved_at"
        ],
        "title": "Session",
        "type": "object"
      },
      "SessionAgenda": {
        "properties": {
          "current_item": {
            "description": "Title of the current agenda item.",
            "examples": [
              "Opening round"
            ],
            "title": "Current Item",
            "type": "string"
          },
          "index": {
            "description": "1-based position of the current item.",
            "examples": [
              1
            ],
            "title": "Index",
            "type": "integer"
          },
          "remaining_s": {
            "description": "Seconds remaining on the current item.",
            "examples": [
              240.0
            ],
            "title": "Remaining S",
            "type": "number"
          },
          "total": {
            "description": "Total number of agenda items.",
            "examples": [
              3
            ],
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "current_item",
          "remaining_s",
          "index",
          "total"
        ],
        "title": "SessionAgenda",
        "type": "object"
      },
      "StartRequest": {
        "properties": {
          "project_id": {
            "description": "Id of an allowed working folder.",
            "examples": [
              "quarterly-planning"
            ],
            "title": "Project Id",
            "type": "string"
          },
          "title": {
            "description": "Title for the new session.",
            "examples": [
              "Quarterly planning"
            ],
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "title"
        ],
        "title": "StartRequest",
        "type": "object"
      },
      "StopRequest": {
        "properties": {
          "confirm": {
            "description": "Must be `true`; a safety guard against an accidental stop.",
            "examples": [
              true
            ],
            "title": "Confirm",
            "type": "boolean"
          },
          "force": {
            "default": false,
            "description": "Stop even if participants are still in the meeting.",
            "examples": [
              false
            ],
            "title": "Force",
            "type": "boolean"
          }
        },
        "required": [
          "confirm"
        ],
        "title": "StopRequest",
        "type": "object"
      },
      "Stt": {
        "properties": {
          "connected": {
            "description": "Whether the speech-to-text engine is connected.",
            "examples": [
              true
            ],
            "title": "Connected",
            "type": "boolean"
          },
          "engine": {
            "description": "Name of the speech-to-text engine in use.",
            "examples": [
              "speechmatics"
            ],
            "title": "Engine",
            "type": "string"
          },
          "minutes_today": {
            "description": "Minutes of audio transcribed today.",
            "examples": [
              12.0
            ],
            "title": "Minutes Today",
            "type": "number"
          },
          "seconds_since_last_final": {
            "description": "Seconds since the last final transcript line.",
            "examples": [
              1.5
            ],
            "title": "Seconds Since Last Final",
            "type": "number"
          }
        },
        "required": [
          "connected",
          "engine",
          "seconds_since_last_final",
          "minutes_today"
        ],
        "title": "Stt",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The operator console contract (ADR 0019 style, issue #159): the status snapshot, its SSE push channel and the start/stop/project commands. Audience: operator -- a separate token from the participant/room surface, never shared with it.",
    "title": "CoThinker operator console",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/operator/events": {
      "get": {
        "description": "`operator-status`: the full snapshot, pushed on change, at most\nonce every `push_interval_s` (default 1s, issue #159's \"at most\n1/s\").",
        "operationId": "get_events_operator_events_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Events",
        "tags": [
          "events"
        ]
      }
    },
    "/operator/project": {
      "post": {
        "operationId": "post_project_operator_project_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Post Project Operator Project Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Project",
        "tags": [
          "commands"
        ]
      }
    },
    "/operator/projects": {
      "get": {
        "operationId": "get_projects_operator_projects_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  },
                  "title": "Response Get Projects Operator Projects Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Projects",
        "tags": [
          "projects"
        ]
      }
    },
    "/operator/start": {
      "post": {
        "operationId": "post_start_operator_start_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Post Start Operator Start Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Start",
        "tags": [
          "commands"
        ]
      }
    },
    "/operator/status": {
      "get": {
        "operationId": "get_status_operator_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Status",
        "tags": [
          "status"
        ]
      }
    },
    "/operator/stop": {
      "post": {
        "operationId": "post_stop_operator_stop_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Post Stop Operator Stop Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Stop",
        "tags": [
          "commands"
        ]
      }
    }
  }
}
